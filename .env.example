# ==============================================================================
# Hydranet DLMM Market Maker - Public Configuration
# ==============================================================================

# Hydranet Node JSON-RPC URL (Default: http://localhost:5003)
HYDRA_RPC_URL=http://localhost:5003

# Market Making Pairs
# Directional DLMM: BTC/USDC, ETH/USDC, ETH/BTC, HDN/USDC
# Cross-Chain 1:1 Stableswap Pegs: ETH(Arb)/ETH(Eth), USDC(Arb)/USDC(Eth)
ACTIVE_PAIR=BTC/USDC

# Execution Mode: true for dry-run simulation, false for real limit order placement
DRY_RUN=true

# Cashu Ecash Protocol (Zero-Node Lightning Liquidity Rail)
# Testnet Signet Mint: http://136.113.240.168:3338 (or http://127.0.0.1:3338 with --start-local-mint)
# Mainnet Mint Example: https://mint.minibits.cash/Bitcoin
CASHU_ENABLED=true
CASHU_MINT_URL=http://136.113.240.168:3338
CASHU_AUTO_SWEEP=true
CASHU_AUTO_REFUEL=true
CASHU_MIN_SINK_SATS=20000

# Web Dashboard Port
DASHBOARD_PORT=8080
